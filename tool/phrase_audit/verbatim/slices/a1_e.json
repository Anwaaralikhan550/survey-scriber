            ],
            "lower": true
          },
          {
            "kind": "dropdown",
            "token": "{A1_FLOOR_COVERING}",
            "dropdown": "android_material_design_spinner3",
            "field_label": "Floor covering",
            "dropdown_options": [
              "Fully covered",
              "Partly covered",
              "Uncovered"
            ],
            "pdf_options": [
              "fully covered",
              "partly covered",
              "uncovered"
            ],
            "lower": true
          }
        ],
        "pdf": [
          "Status: At the time of my inspection, the property was occupied, vacant, or partly occupied.",
