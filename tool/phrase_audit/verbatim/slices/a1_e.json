[
  {
    "screen": "activity_property_weather",
    "replace_all": true,
    "keep": [],
    "rules": [
      {
        "id": "a1_weather",
        "masters": [
          "{D_WEATHER}"
        ],
        "sub": "{A1_WEATHER}",
        "text": "Weather: At the time of my inspection, the weather was {A1_WEATHER_NOW}, following a period of {A1_WEATHER_BEFORE} weather. Weather conditions can influence the visibility of certain defects, particularly those associated with roof coverings, rainwater goods, and dampness.",
        "tokens": [
          {
            "kind": "dropdown",
            "token": "{A1_WEATHER_NOW}",
            "dropdown": "android_material_design_spinner",
            "field_label": "Current weather",
            "dropdown_options": [
              "Dry",
              "Wet",
              "Overcast",
              "Sunny",
              "Cold",
              "Windy",
              "Rainy",
              "Snowing"
            ],
            "pdf_options": [
              "dry",
              "wet",
              "overcast",
              "sunny",
              "cold",
              "windy",
              "rainy",
              "snowing"
            ],
            "lower": true
          },
          {
            "kind": "dropdown",
            "token": "{A1_WEATHER_BEFORE}",
            "dropdown": "android_material_design_spinner2",
            "field_label": "Previous weather",
            "dropdown_options": [
              "Dry",
              "Wet",
              "Overcast",
              "Sunny",
              "Cold",
              "Windy",
              "Rainy",
              "Snowing"
            ],
            "pdf_options": [
              "dry",
              "wet",
              "overcast",
              "sunny",
              "cold",
              "windy",
              "rainy",
              "snowing"
            ],
            "lower": true
          }
        ],
        "pdf": [
          "Weather: At the time of my inspection, the weather was dry, wet, overcast, sunny, cold, windy, rainy, snowing, following a period of dry, wet, overcast, sunny, cold, windy, rainy, snowing weather."
        ],
        "when": [
          "android_material_design_spinner",
          "Dry"
        ],
        "when_any": [
          [
            "android_material_design_spinner",
            "Wet"
          ],
          [
            "android_material_design_spinner",
            "Overcast"
          ],
          [
            "android_material_design_spinner",
            "Sunny"
          ],
          [
            "android_material_design_spinner",
            "Cold"
          ],
          [
            "android_material_design_spinner",
            "Windy"
          ],
          [
            "android_material_design_spinner",
            "Rainy"
          ],
          [
            "android_material_design_spinner",
            "Snowing"
          ]
        ]
      }
    ]
  },
  {
    "screen": "activity_property_status",
    "replace_all": true,
    "keep": [],
    "rules": [
      {
        "id": "a1_status",
        "masters": [
          "{D_PROPERTY_STATUS}"
        ],
        "sub": "{A1_STATUS}",
        "text": "Status: At the time of my inspection, the property was {A1_OCCUPANCY}. The property was {A1_FURNISHING}, and floor surfaces were {A1_FLOOR_COVERING}, which limited inspection of concealed areas.",
        "tokens": [
          {
            "kind": "dropdown",
            "token": "{A1_OCCUPANCY}",
            "dropdown": "android_material_design_spinner",
            "field_label": "Occupancy",
            "dropdown_options": [
              "Occupied",
              "Vacant",
              "Partly occupied"
            ],
            "pdf_options": [
              "occupied",
