[
  {
    "screen": "activity_property_construction",
    "replace_all": true,
    "keep": [],
    "rules": [
      {
        "id": "a3_type",
        "masters": [
          "{D_CONSTRUCTION}"
        ],
        "sub": "{A3_TYPE}",
        "text": "Type: The property is believed to be constructed using {A3_CONSTRUCTION_TYPE} construction.",
        "tokens": [
          {
            "kind": "checks",
            "token": "{A3_CONSTRUCTION_TYPE}",
            "options": [
              [
                "a3_type_0_traditional_masonry",
                "traditional masonry"
              ],
              [
                "a3_type_0_solid_wall",
                "solid wall"
              ],
              [
                "a3_type_0_cavity_wall",
                "cavity wall"
              ],
              [
                "a3_type_0_timber_frame",
                "timber frame"
              ],
              [
                "a3_type_0_steel_frame",
                "steel frame"
              ],
              [
                "a3_type_0_concrete_wall",
                "concrete wall"
              ],
              [
                "a3_type_0_precast_concrete_panels",
                "precast concrete panels"
              ],
              [
                "a3_type_0_system_built",
                "system-built"
              ]
            ],
            "pdf_options": [
              "traditional masonry",
              "solid wall",
              "cavity wall",
              "timber frame",
              "steel frame",
              "concrete wall",
              "precast concrete panels",
              "system-built"
            ],
            "label": "Constructed using",
            "other": [
              "a3_type_0_other",
              "a3_type_0_other_text"
            ]
          }
        ],
        "pdf": [
          "Type: The property is believed to be constructed using traditional masonry, solid wall, cavity wall, timber frame, steel frame, concrete wall, precast concrete panels, system-built, other construction."
        ],
        "when": [
          "cb_a3_type",
          "true"
        ],
        "extra_fields": [
          {
            "id": "cb_a3_type",
            "label": "Construction type",
            "type": "checkbox"
          }
        ]
      },
      {
        "id": "a3_visible",
        "masters": [
          "{D_CONSTRUCTION}"
        ],
        "sub": "{A3_VISIBLE_ONLY}",
        "text": "Construction has been identified from visible inspection only and has not been confirmed by opening concealed elements.",
        "tokens": [],
        "when": [
          "cb_a3_visible",
          "true"
        ],
        "extra_fields": [
          {
            "id": "cb_a3_visible",
            "label": "Construction identified from visible inspection only",
            "type": "checkbox"
          }
        ]
      },
      {
        "id": "a3_modern",
        "masters": [
          "{D_CONSTRUCTION}"
        ],
        "sub": "{A3_MODERN_BUILDING_DESIGN}",
        "text": "Modern Building Design: The building is believed to be of a modern design, framed externally with timber, steel, or other materials, but most of the framework is concealed on both sides by cladding. The durability of the structure is dependent upon the care taken during construction. For this reason, I cannot comment on the condition of the concealed structure, given the limited scope and technique of the inspection. Please be aware that any alteration to this type of building will require specialist advice from a qualified person. The exterior of the property must be adequately maintained to prevent water penetration. It is also important to reduce the risk of condensation that might encourage damage or weaken concealed components. When improving insulation, you should ensure that the material used is appropriate. You can only install insulation within the wall cavity with specialist advice.",
        "tokens": [],
        "when": [
          "a3_type_0_timber_frame",
          "true"
        ],
        "when_any": [
          [
            "a3_type_0_steel_frame",
            "true"
          ]
        ]
      },
      {
        "id": "a3_concrete",
        "masters": [
          "{D_CONSTRUCTION}"
        ],
        "sub": "{A3_CONCRETE_ADVISORY}",
        "text": "Where the property is of concrete or precast concrete panel construction, some lenders may regard this as a non-standard form of construction. As a result, the availability of mortgage finance may be more limited than for traditionally constructed properties, and some lenders may decline to lend altogether. Lending criteria vary between mortgage providers and may depend on the specific construction type, its condition, and whether any approved repair or certification schemes have been carried out. You should make enquiries with your proposed lender or an independent mortgage broker at an early stage to confirm that satisfactory mortgage finance will be available before committing to the purchase.",
        "tokens": [],
        "when": [
          "a3_type_0_concrete_wall",
          "true"
        ],
        "when_any": [
          [
            "a3_type_0_precast_concrete_panels",
            "true"
          ]
        ]
      }
    ]
  },
