        "id": "f5_general",
        "masters": [
          "{F_FIREPLACES_AND_CHIMNEYS}"
        ],
        "sub": "{F5_GENERAL_MAINTENANCE}",
        "text": "General Maintenance: Fireplaces, flues, and combustion appliances should be inspected and serviced regularly by appropriately qualified contractors. Unused flues should be adequately ventilated to reduce the risk of condensation and dampness. Where fireplaces are no longer required, appropriate capping and ventilation should be maintained.",
        "tokens": [],
        "when": [
          "cb_general_maintenance",
          "true"
