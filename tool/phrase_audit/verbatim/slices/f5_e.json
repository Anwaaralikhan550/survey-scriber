  {
    "screen": "activity_inside_property_fireplaces_main_screen",
    "rules": [
      {
        "id": "f5_intro",
        "masters": [
          "{F_FIREPLACES_AND_CHIMNEYS}"
        ],
        "sub": "{F5_INTRO}",
        "text": "This section relates to visible fireplaces, chimney breasts, and associated flues within the property. The inspection was limited to a visual assessment only. Fireplaces, flues, and appliances were not assessed, dismantled, or operated unless otherwise stated. The internal condition of chimney flues, liners and concealed structural elements cannot be confirmed during a visual inspection. No smoke testing, CCTV survey or opening up was undertaken. Combustion appliances should be provided with adequate permanent ventilation in accordance with current standards. The adequacy of ventilation has not been assessed during this inspection.",
        "tokens": [],
        "when": [
          "android_material_design_spinner4",
          "1"
        ],
        "when_any": [
          [
            "android_material_design_spinner4",
            "2"
          ],
          [
            "android_material_design_spinner4",
            "3"
          ]
        ],
        "first": true
      },
