  {
    "screen": "activity_inside_property_ceilings_polystyrene",
    "replace_all": true,
    "keep": [],
    "rules": [
      {
        "id": "f2_poly",
        "masters": [
          "{F_CEILINGS}"
        ],
        "sub": "{F2_POLYSTYRENE}",
        "text": "Polystyrene Ceiling Tiles: Parts of the ceilings are covered with polystyrene tiles, which present a fire safety risk. Polystyrene is highly flammable and, if ignited, can contribute to the rapid spread of fire while releasing dense, toxic smoke and harmful fumes that can significantly increase the risk to occupants. Although these tiles may have been acceptable when installed, they no longer meet modern fire safety expectations. They should be removed as soon as practicable by a competent contractor. Be aware that removal may damage the underlying ceiling, particularly if the tiles have been firmly bonded, and repairs or complete replacement of the ceiling finish may be required.",
        "tokens": [],
        "when": [
          "cb_not_inspected",
          "true"
        ],
        "extra_fields": [
          {
            "id": "cb_not_inspected",
            "label": "Polystyrene ceiling tiles",
            "type": "checkbox"
          }
        ]
      }
    ]
  },
