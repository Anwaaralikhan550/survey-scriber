  {
    "screen": "activity_outside_property_limitation",
    "replace_all": true,
    "keep": [],
    "rules": [
      {
        "id": "e0_ground",
        "masters": [
          "{E_LIMITATIONS}"
        ],
        "sub": "{E0_GROUND_LEVEL}",
        "text": "My inspection of the exterior was carried out from ground level and other reasonably accessible positions.",
        "tokens": [],
        "when": [
          "cb_e0_ground",
          "true"
        ],
        "extra_fields": [
          {
            "id": "cb_e0_ground",
            "label": "Inspected from ground level",
            "type": "checkbox"
          }
        ]
      },
      {
        "id": "e0_vantage",
        "masters": [
          "{E_LIMITATIONS}"
        ],
        "sub": "{E0_VANTAGE_POINTS}",
        "text": "My inspection was restricted by the surrounding elements, including the layout of the area, and available vantage points from which I was able to view the property.",
        "tokens": [],
        "when": [
          "cb_e0_vantage",
          "true"
        ],
        "extra_fields": [
          {
            "id": "cb_e0_vantage",
            "label": "Restricted by surrounding elements",
            "type": "checkbox"
          }
        ]
      },
      {
        "id": "e0_limited",
        "masters": [
          "{E_LIMITATIONS}"
        ],
        "sub": "{E0_LIMITED_BY}",
        "text": "Limitations: The inspection was limited by {E0_LIMITS}.",
        "tokens": [
          {
            "kind": "checks",
            "token": "{E0_LIMITS}",
            "options": [
              [
                "e0l_height",
                "height"
              ],
              [
                "e0l_restricted_access",
                "restricted access"
              ],
              [
                "e0l_nearby_buildings",
                "nearby buildings"
              ],
              [
                "e0l_vegetation",
                "vegetation"
              ],
              [
                "e0l_weather_conditions",
                "weather conditions"
              ],
              [
                "e0l_roof_configuration",
                "roof configuration"
              ],
              [
                "e0l_health_and_safety_considerations",
                "health and safety considerations"
              ]
            ],
            "pdf_options": [
              "height",
              "restricted access",
              "nearby buildings",
              "vegetation",
              "weather conditions",
              "roof configuration",
              "health and safety considerations"
            ],
            "label": "Limited by"
          }
        ],
        "pdf": [
          "Limitations: The inspection was limited by height, restricted access, nearby buildings, vegetation, weather conditions, roof configuration, health and safety considerations."
        ],
        "when": [
          "cb_e0_limited",
          "true"
        ],
        "extra_fields": [
          {
            "id": "cb_e0_limited",
            "label": "Inspection limited by",
            "type": "checkbox"
          }
        ]
      },
      {
        "id": "e0_restricted",
        "masters": [
          "{E_LIMITATIONS}"
        ],
        "sub": "{E0_RESTRICTED_ACCESS}",
        "text": "Restricted Access: There was no direct access to the rear of the building. For this reason, I cannot make any detailed comments regarding the condition of the uninspected walls, roof slopes, rainwater goods, etc. You should accept the risk that some defects may exist in these unseen areas.",
        "tokens": [],
        "when": [
          "cb_e0_restricted",
          "true"
        ],
        "extra_fields": [
          {
            "id": "cb_e0_restricted",
            "label": "No direct access to the rear",
            "type": "checkbox"
          }
        ]
      },
      {
        "id": "e0_binoculars",
        "masters": [
          "{E_LIMITATIONS}"
        ],
        "sub": "{E0_BINOCULARS}",
        "text": "Roof coverings, chimney stacks, and high-level elements were inspected using binoculars where appropriate. No parts of the building were opened up, dismantled, or assessed. Where elements were concealed or inaccessible, no comment can be made regarding their condition.",
        "tokens": [],
        "when": [
          "cb_e0_binoculars",
          "true"
        ],
        "extra_fields": [
          {
            "id": "cb_e0_binoculars",
            "label": "Binoculars / nothing opened up",
            "type": "checkbox"
          }
        ]
      }
    ]
  },
