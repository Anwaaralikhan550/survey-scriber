  {
    "screen": "activity_topography",
    "replace_all": true,
    "keep": [],
    "rules": [
      {
        "id": "a4_topo",
        "masters": [
          "{D_GROUND}"
        ],
        "sub": "{A4_TOPOGRAPHY}",
        "text": "Topology: The property occupies {A4_SLOPE} ground.",
        "tokens": [
          {
            "kind": "dropdown",
            "token": "{A4_SLOPE}",
            "dropdown": "android_material_design_spinner",
            "field_label": "Ground",
            "dropdown_options": [
              "Level",
              "Gently sloping",
              "Moderately sloping",
              "Steeply sloping"
            ],
            "pdf_options": [
              "level",
              "gently sloping",
              "moderately sloping",
              "steeply sloping"
            ],
            "lower": true
          }
        ],
        "pdf": [
          "Topology: The property occupies level, gently sloping, moderately sloping, steeply sloping ground."
        ],
        "when": [
          "android_material_design_spinner",
          "Level"
        ],
        "when_any": [
          [
            "android_material_design_spinner",
            "Gently sloping"
          ],
          [
            "android_material_design_spinner",
            "Moderately sloping"
          ],
          [
            "android_material_design_spinner",
            "Steeply sloping"
          ]
        ]
      }
    ]
  },
