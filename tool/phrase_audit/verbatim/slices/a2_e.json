              "Not converted",
              "Converted"
            ]
          }
        ]
      },
      {
        "id": "a2_converted",
        "masters": [
          "{D_CONVERTED}"
        ],
        "sub": "{A2_CONVERTED}",
        "text": "Converted: The property has been converted from its original use. The property was a {A2_PRIOR_TYPE}, which has been converted to self-contained units.",
        "tokens": [
          {
            "kind": "checks",
            "token": "{A2_PRIOR_TYPE}",
            "options": [
              [
                "a2c_detached_house",
                "detached house"
              ],
              [
                "a2c_semi_detached_house",
                "semi-detached house"
              ],
              [
                "a2c_mid_terrace_house",
                "mid-terrace house"
              ],
              [
                "a2c_end_terrace_house",
                "end-terrace house"
              ]
            ],
            "pdf_options": [
              "detached house",
              "semi-detached house",
              "mid-terrace house",
              "end-terrace house"
            ],
            "label": "The property was a",
            "other": [
              "a2c_other",
              "a2c_other_text"
            ]
          }
        ],
        "pdf": [
          "The property was a detached house, semi-detached house, mid-terrace house, end-terrace house, other, which has been converted to self-contained units."
        ],
        "when": [
          "android_material_design_spinner",
          "Converted"
        ]
      },
      {
        "id": "a2_known_date",
        "masters": [
          "{D_CONVERTED}"
        ],
        "sub": "{A2_KNOWN_DATE}",
        "text": "Known date: The year of conversion is {A2_YEAR_CONVERTED}. Your legal adviser should confirm that all statutory local authority consents and approvals are in place.",
        "tokens": [
          {
            "kind": "text",
            "token": "{A2_YEAR_CONVERTED}",
            "dropdown": "textView3",
            "field_label": "Year of conversion"
          }
        ],
        "pdf": [
          "Known date: The year of conversion is (YYYY)."
        ],
        "when": [
          "actv_a2_conversion_date",
          "Known date"
        ],
        "extra_fields": [
          {
            "id": "actv_a2_conversion_date",
            "label": "Date of conversion",
            "type": "dropdown",
            "options": [
              "Known date",
              "Unknown date"
            ]
          }
        ]
      },
      {
        "id": "a2_unknown_date",
        "masters": [
          "{D_CONVERTED}"
        ],
        "sub": "{A2_UNKNOWN_DATE}",
        "text": "Unknown date: The date of conversion is unknown. Your legal adviser should verify that all appropriate statutory approvals and completion certificates were obtained.",
        "tokens": [],
        "when": [
          "actv_a2_conversion_date",
          "Unknown date"
        ]
      }
    ]
  },
