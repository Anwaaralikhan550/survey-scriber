    "rules": [
      {
        "id": "e5_sill",
        "masters": [
          "{E_WINDOWS}"
        ],
        "sub": "{E5_SILL_PROJECTION}",
        "text": "Sill projection: Externally, the windowsills beyond the face of the walls appear to project adequately beyond the face of the walls. The junctions between the window frames and the surrounding wall openings appear to be {SILL_SEALING} sealed. These seals should be inspected regularly for cracking and repaired as necessary to prevent water ingress.",
        "tokens": [
          {
            "kind": "dropdown",
            "token": "{SILL_SEALING}",
            "dropdown": "actv_condition",
            "field_label": "Sealing around windows",
            "dropdown_options": [
              "Properly",
              "Fairly",
              "Poorly"
            ],
            "pdf_options": [
              "properly",
              "fairly",
              "poorly"
            ],
            "lower": true,
            "cond": "actv_projection_type=Sill projection"
          }
        ],
        "pdf": [
          "The junctions between the window frames and the surrounding wall openings appear to be properly, fairly, poorly sealed."
        ],
        "when": [
          "actv_projection_type",
          "Sill projection"
        ],
        "extra_fields": [
          {
            "id": "actv_projection_type",
