      {
        "id": "j1_structural",
        "masters": [
          "{RISK_TO_BUILDING}"
        ],
        "sub": "{J1_STRUCTURAL_MOVEMENT}",
        "text": "Structural Movement: Evidence of {J1_MOVEMENT_KIND} movement, including possible structural was observed. Where movement appears progressive or structurally significant, further investigation by an appropriately qualified structural engineer is recommended before legal commitment.",
        "tokens": [
          {
            "kind": "checks",
            "token": "{J1_MOVEMENT_KIND}",
            "options": [
              [
                "j1_structural_0_historic",
                "historic"
              ],
              [
                "j1_structural_0_localised",
                "localised"
              ],
              [
                "j1_structural_0_recurring",
                "recurring"
              ],
              [
                "j1_structural_0_progressive",
                "progressive"
              ]
            ],
            "pdf_options": [
              "historic",
              "localised",
              "recurring",
              "progressive"
            ],
            "label": "Evidence of"
          }
        ],
        "pdf": [
          "Structural Movement: Evidence of historic, localised, recurring, progressive movement, including possible structural was observed."
        ],
        "when": [
          "cb_j1_structural",
          "true"
        ],
        "extra_fields": [
          {
            "id": "cb_j1_structural",
            "label": "Structural movement",
            "type": "checkbox"
          }
        ]
      },
